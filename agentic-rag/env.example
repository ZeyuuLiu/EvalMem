# Copy to .env and adjust. Keep caches on a data disk (see SETUP.md).

# --- Disk / Hugging Face (avoid filling the system drive) ---
HF_HOME=${HOME}/.cache/huggingface
TRANSFORMERS_CACHE=${HF_HOME}/transformers

# --- vLLM OpenAI-compatible API (Qwen3-8B) ---
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL_NAME=Qwen3-8B

# --- Embedding backend ---
# openai: use a deployed embedding service (recommended);
# local : load a local HF embedding model inside the Python process.
EMBEDDING_BACKEND=openai
EMBEDDING_BASE_URL=http://127.0.0.1:8001/v1
EMBEDDING_API_KEY=EMPTY
EMBEDDING_MODEL_NAME=Qwen3-Embedding-0.6B

# --- Local embedding model directory (used when EMBEDDING_BACKEND=local) ---
# Path to a local clone / HF cache of Qwen3-Embedding-0.6B.
EMBEDDING_MODEL_PATH=/path/to/Qwen3-Embedding-0.6B

# Embedding vector size for Qwen3-Embedding-0.6B default full dim
EMBEDDING_DIM=1024
# cuda | cpu | cuda:0  (only used when EMBEDDING_BACKEND=local)
EMBEDDING_DEVICE=cuda

# --- Qdrant ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=agentic_rag_docs
# Top-k retrieved (increase for long-document settings, e.g. 12-20)
RETRIEVE_K=8

# retrieve : vector search first, then LLM (default, no tool-call parsing required)
# react    : LangGraph ReAct tool-calling
RAG_MODE=retrieve
